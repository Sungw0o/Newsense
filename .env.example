SPRING_PROFILES_ACTIVE=prod

# Web entrypoint. Use 127.0.0.1 with Cloudflare Tunnel to avoid direct public exposure.
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_HTTP_PORT=8080

MYSQL_DATABASE=newsense
MYSQL_USER=newsense
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me

# Keep validate in stable operation. Use update only for the first MVP schema boot, then revert to validate.
SPRING_JPA_DDL_AUTO=validate

MONGO_DATABASE=newsense
MONGO_INITDB_ROOT_USERNAME=newsense
MONGO_INITDB_ROOT_PASSWORD=change-mongo-me

JWT_SECRET=replace-with-at-least-32-byte-production-secret
JWT_ACCESS_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=1209600000

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

CRAWLER_ENABLED=true
BOK_CRAWLER_LIST_URL=https://www.bok.or.kr/portal/singl/newsData/listCont.do?pageIndex=1&targetDepth=3&menuNo=201263&syncMenuChekKey=1&searchCnd=1&searchKwd=
MOEF_CRAWLER_LIST_URL=https://www.moef.go.kr/nw/nes/nesdta.do?menuNo=4010100
