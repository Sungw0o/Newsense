FROM eclipse-temurin:21-jre-jammy

WORKDIR /app

ENV SPRING_PROFILES_ACTIVE=prod \
    SERVER_PORT=8080 \
    TZ=Asia/Seoul

RUN groupadd --system newsense && useradd --system --gid newsense newsense

COPY build/libs/*.jar app.jar

USER newsense

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
